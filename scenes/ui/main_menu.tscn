[node name="MainMenu" type="Control" node_paths=PackedStringArray("control_manager")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")
control_manager = NodePath("Systems/ControlManager")

[node name="Background" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="ControlsUI" parent="." instance=ExtResource("2_controls_ui")]
visible = false
layout_mode = 1

[node name="MainScreen" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("10_safe_area")

[node name="Content" type="VBoxContainer" parent="MainScreen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 36.0
offset_right = -48.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6

[node name="CurrencyBar" parent="MainScreen/Content" instance=ExtResource("11_currency_bar")]
unique_name_in_owner = true
layout_mode = 2

[node name="TitleSpacer" type="Control" parent="MainScreen/Content"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="MainScreen/Content"]
layout_mode = 2
theme_type_variation = &"TitleLarge"
text = "Sky Jump"
horizontal_alignment = 1

[node name="BestLabel" type="Label" parent="MainScreen/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "Best 0 m"
horizontal_alignment = 1

[node name="SkinSelector" parent="MainScreen/Content" instance=ExtResource("9_skin_selector")]
unique_name_in_owner = true
layout_mode = 2

[node name="ButtonsMargin" type="MarginContainer" parent="MainScreen/Content"]
layout_mode = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 64

[node name="Buttons" type="VBoxContainer" parent="MainScreen/Content/ButtonsMargin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="DayGroup" type="VBoxContainer" parent="MainScreen/Content/ButtonsMargin/Buttons"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="DailyButton" type="Button" parent="MainScreen/Content/ButtonsMargin/Buttons/DayGroup"]
unique_name_in_owner = true
