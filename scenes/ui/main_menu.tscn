layout_mode = 2
focus_mode = 0
theme_type_variation = &"ButtonYellow"
text = "Day"

[node name="StreakBadge" type="HBoxContainer" parent="MainScreen/Content/ButtonsMargin/Buttons/DayGroup"]
unique_name_in_owner = true
layout_mode = 2
