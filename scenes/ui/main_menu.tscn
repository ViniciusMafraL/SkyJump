[node name="Systems" type="Node" parent="."]

[node name="ControlManager" type="Node" parent="Systems" node_paths=PackedStringArray("controls_ui")]
script = ExtResource("4_controls")
default_config = ExtResource("5_control_config")
controls_ui = NodePath("../../ControlsUI")

[node name="TouchInvisibleControl" type="Node" parent="Systems/ControlManager"]
script = ExtResource("6_touch")
scheme_id = &"touch_invisible"
