[sub_resource type="Gradient" id="Gradient_sky"]
colors = PackedColorArray(0.12, 0.22, 0.48, 1, 0.72, 0.82, 0.93, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_sky"]
gradient = SubResource("Gradient_sky")
width = 8
height = 256
fill_from = Vector2(0.5, 0)
fill_to = Vector2(0.5, 1)

[node name="MainMenu" type="Control" node_paths=PackedStringArray("control_manager")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")
control_manager = NodePath("Systems/ControlManager")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = SubResource("GradientTexture2D_sky")
expand_mode = 1

[node name="ControlsUI" parent="." instance=ExtResource("2_controls_ui")]
visible = false
layout_mode = 1

[node name="MainScreen" type="Control" parent="."]
unique_name_in_owner = true
