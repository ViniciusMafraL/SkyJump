[gd_resource type="Resource" script_class="ObjectTestStation" format=3]

[ext_resource type="Script" path="res://scripts/test_room/object_test_station.gd" id="1_station"]
[ext_resource type="Script" path="res://scripts/test_room/object_placement.gd" id="2_placement"]
[ext_resource type="Script" path="res://scripts/test_room/platform_placement.gd" id="3_base"]
[ext_resource type="Resource" path="res://config/platforms/wall_platform.tres" id="c0"]
[ext_resource type="Resource" path="res://config/platforms/large_platform.tres" id="c1"]

[sub_resource type="Resource" id="Resource_wall"]
script = ExtResource("2_placement")
platform_config = ExtResource("c0")
height = -1.0
angle_degrees = 40.0

[sub_resource type="Resource" id="Resource_landing"]
script = ExtResource("2_placement")
platform_config = ExtResource("c1")
height = 4.0
angle_degrees = 333.0

[resource]
script = ExtResource("1_station")
display_name = "Plataforma-Parede"
settings_section = &"wall"
placements = Array[ExtResource("3_base")]([SubResource("Resource_wall"), SubResource("Resource_landing")])
